# Copy to .env.local (git-ignored). `npx convex dev` fills in the Convex values.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Clerk -> API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# The following are set on the Convex deployment, not here:
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN https://<your-app>.clerk.accounts.dev
#   npx convex env set ADMIN_EMAILS you@example.com
#   npx convex env set N8N_WEBHOOK_URL http://localhost:5678/webhook/lendloop/loan-events
#   npx convex env set N8N_SHARED_SECRET <same value as LENDLOOP_SHARED_SECRET in .env.n8n>
